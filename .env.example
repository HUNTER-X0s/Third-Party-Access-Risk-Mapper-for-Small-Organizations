# ACCESSGUARD ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env for production deployment

# Application Settings
PROJECT_NAME="AccessGuard"
VERSION="1.5.0"
API_V1_STR="/api/v1"
DEMO_MODE=false

# Secrets (Change in Production — Never commit real secrets to source control)
SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
DATABASE_URL="sqlite:///./accessguard.db"

# Organization Baseline
ORGANIZATION_NAME="Aarohan Technologies"
ORGANIZATION_DOMAIN="aarohan.tech"
